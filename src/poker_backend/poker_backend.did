// [Account](https://github.com/dfinity/ICRC-1/blob/main/standards/ICRC-3/README.md#value)
// representation of ledgers supporting the ICRC-1 standard.
type Account = record { owner : principal; subaccount : opt blob };
type Action = variant {
  Call;
  Fold;
  // Bet or raise so that the player's total bet on this street is the given amount.
  Raise : nat64;
  AllIn;
  Check;
};
// Settings an admin can change from the admin page.
type AdminConfig = record {
  // Moderators with their usernames (empty if they have no profile).
  moderators : vec record { principal; text };
  banned_words : vec text;
  signups_per_hour : nat32;
  signup_pow_bits : nat8;
};
type AuditEntry = record { action : text; actor : principal; time : nat64 };
// Where a player stands with auto-sit at a table.
type AutoSitStatus = variant {
  Queued : record { place : nat32; buy_in : nat64; waiting : nat32 };
  // Seated automatically at this table (reported once).
  Seated : record { table : nat64 };
  // Taken out of the line because seating failed (reported once).
  Dropped : record { reason : text };
  NotQueued;
};
// The viewer's own place in a table's auto-sit line.
type AutoSitView = record { place : nat32; buy_in : nat64 };
type Ban = record {
  // 0 = permanent.
  until : nat64;
  reason : text;
};
// A row of a board as shown.
type BoardRow = record {
  username : text;
  // Hands played in the period.
  hands : nat32;
  // Points, or net ICP won (e8s).
  value : int64;
  player : principal;
  // Position on the live list (1-based), the paid place for past winners, or
  // 0 for a player outside the list.
  rank : nat32;
  // The prize if the period ended now; for past winners, what was paid.
  prize : nat64;
  // Can be paid: in the period, with a value above zero, and (winnings
  // boards) enough hands.
  qualified : bool;
  avatar : text;
};
// One leaderboard as shown.
type BoardView = record {
  // The caller's row (rank 0 when outside the list).
  me : opt BoardRow;
  // When the period ends (ns).
  ends_at : nat64;
  // The board's prize pool (e8s).
  pool : nat64;
  // The top 10.
  rows : vec BoardRow;
  // The period: "2026-W43" or "2026-11".
  label : text;
  // The paid winners of the last closed period.
  last_winners : vec BoardRow;
  // "weekly_points", "weekly_winnings", "monthly_points" or "monthly_winnings".
  board : text;
};
type Channel = variant { Lobby; Table : nat64 };
type ChatMessage = record {
  id : nat64;
  username : text;
  from : opt principal;
  kind : MessageKind;
  "text" : text;
  time : nat64;
};
// What a table plays for: real ICP (1 chip = 1 e8s) or free play chips.
type Currency = variant { Icp; Chips };
type DepositInfo = record {
  fee : nat64;
  // Legacy account identifier for exchanges / older wallets.
  account_id : text;
  ledger : principal;
  // ICRC-1 account to send ICP to (this canister + your deposit subaccount).
  account : Account;
};
type EarnedMedal = record { id : text; earned_at : nat64 };
type FriendInfo = record {
  id : principal;
  username : text;
  tables : vec nat64;
  avatar : text;
  online : bool;
};
// One friend in the referrer's list.
type FriendRow = record {
  // Earned the referrer something in the last 7 days.
  active : bool;
  username : text;
  // When the 12-month earning window for this friend ends (ns).
  ends_at : nat64;
  // Cuts earned from this friend (e8s). Earned, not paid: a cut forfeited
  // because the referrer was suspended at payout still counts here.
  earned : nat64;
  joined_at : nat64;
};
type HandPlayer = record {
  won : nat64;
  username : text;
  player : principal;
  // Hole cards. Stored for everyone; views only reveal your own and shown hands.
  cards : blob;
  seat : nat8;
  committed : nat64;
  shown : bool;
};
type HandRecord = record {
  id : nat64;
  log : vec LogEntry;
  pot : nat64;
  small_blind : nat64;
  hand_no : nat64;
  rake : nat64;
  time : nat64;
  table_id : nat64;
  players : vec HandPlayer;
  currency : Currency;
  big_blind : nat64;
  board : blob;
  button : nat8;
  table_name : text;
};
type HandResult = record {
  pot : nat64;
  hand_no : nat64;
  rake : nat64;
  shown : vec ShownHand;
  players : vec PlayerResult;
  board : blob;
  winners : vec Winner;
  // Taken from the pot for the bad-beat jackpot.
  jackpot_drop : nat64;
};
type HandSummary = record {
  id : nat64;
  // What the viewer won minus what they put in.
  net : int64;
  pot : nat64;
  my_cards : blob;
  time : nat64;
  currency : Currency;
  board : blob;
  table_name : text;
};
type HouseStats = record {
  // What the canister's main ledger account must hold to cover everything.
  liabilities_total : nat64;
  chips_on_tables : nat64;
  // ICP bad-beat jackpot.
  jackpot : nat64;
  wallet_balances : nat64;
  // Fish and leaderboard prize pools, owed to players.
  rewards_pools : nat64;
  // Referral cuts owed to referrers, paid at the weekly close.
  referral_owed : nat64;
  users : nat64;
  treasury : nat64;
};
type HttpRequest = record {
  url : text;
  method : text;
  body : blob;
  headers : vec record { text; text };
};
type HttpResponse = record {
  body : blob;
  headers : vec record { text; text };
  status_code : nat16;
};
type InitArgs = record { ledger : opt principal; ledger_fee : opt nat64 };
type ItemKind = variant { CardBack; Throwable; Avatar; Gift };
type JackpotHit = record {
  winner_cards : blob;
  total : nat64;
  loser_hand : text;
  loser_name : text;
  hand_no : nat64;
  time : nat64;
  table_id : nat64;
  winner : principal;
  loser : principal;
  currency : Currency;
  board : blob;
  loser_cards : blob;
  table_name : text;
  payouts : vec JackpotPayout;
  winner_hand : text;
  winner_name : text;
};
type JackpotInfo = record {
  icp : nat64;
  min_players : nat8;
  chips : nat64;
  qualifying_hand : text;
  winner_bps : nat64;
  loser_bps : nat64;
  payout_bps : nat64;
  drop_bps : nat16;
  recent : vec JackpotHit;
};
type JackpotPayout = record {
  username : text;
  player : principal;
  // "loser", "winner" or "table".
  share : text;
  amount : nat64;
};
type LeaderboardEntry = record {
  id : principal;
  username : text;
  level : nat32;
  stats : Stats;
  avatar : text;
};
type LedgerOp = record {
  id : nat64;
  to : Account;
  fee : nat64;
  status : OpStatus;
  updated_at : nat64;
  from : opt Account;
  kind : OpKind;
  // The player (or the controller for treasury withdrawals).
  user : principal;
  from_subaccount : opt blob;
  created_at_time : nat64;
  // Amount moved on the ledger, excluding the fee.
  amount : nat64;
};
// One line of a hand's action log, used for hand histories and replays.
type LogEntry = record {
  seat : opt nat8;
  "text" : text;
  phase : Phase;
  // The player's total bet on this street after the action, or the amount won/returned.
  amount : nat64;
};
type MedalDef = record {
  id : text;
  icon : text;
  name : text;
  description : text;
};
type MessageKind = variant { System; Gift; Text; Throw };
type Metrics = record {
  running_tournaments : nat64;
  last_solvency_surplus_e8s : opt int64;
  treasury_e8s : nat64;
  jackpot_chips : nat64;
  bans : nat64;
  last_solvency_at : opt nat64;
  last_solvency_ok : opt bool;
  idle_stand_ups : nat64;
  reports_filed : nat64;
  open_reports : nat64;
  time : nat64;
  seated_players : nat64;
  ledger_ops_unknown : nat64;
  paused_deposits : bool;
  paused_joins : bool;
  tables : nat64;
  cycles : nat64;
  liabilities_e8s : nat64;
  paused_withdrawals : bool;
  users : nat64;
  ledger_ops_failed : nat64;
  // Players who made an update call in the last 5 minutes.
  active_players_5m : nat64;
  unresolved_ledger_ops : nat64;
  hands_dealt : nat64;
  wallet_total_e8s : nat64;
  paused_dealing : bool;
  stable_bytes : nat64;
  // Tables with at least two players seated.
  active_tables : nat64;
  jackpot_icp_e8s : nat64;
  rate_limited_calls : nat64;
  heap_bytes : nat64;
};
type ModAction = variant {
  // Suspension for this many hours (0 = permanent).
  Ban : nat32;
  Warn;
  Dismiss;
  // Chat mute for this many hours.
  MuteChat : nat32;
};
// What moderators see when they look a player up.
type ModPlayerView = record {
  id : principal;
  ban : opt Ban;
  status : text;
  chat_muted_until : nat64;
  username : text;
  balance : nat64;
  chips : nat64;
  is_moderator : bool;
  created_at : nat64;
  level : nat32;
  // Tables they're seated at.
  tables : vec nat64;
  // Reports against them, newest first (open and resolved, up to 20).
  reports : vec Report;
  last_seen : nat64;
  net_winnings : int64;
  hands_played : nat64;
};
// Color label for a player note (a quick read on a player's style).
type NoteColor = variant { Red; Yellow; Blue; Green; Orange; Purple };
type NoteView = record {
  updated_at : nat64;
  username : text;
  player : principal;
  color : opt NoteColor;
  "text" : text;
  avatar : text;
};
type OpKind = variant {
  // Player withdrawal from their poker balance.
  Withdraw;
  // Sweep of a player's deposit subaccount into the main account.
  Sweep;
  // ICRC-2 transfer_from the player's wallet into the canister.
  Deposit;
  // Controller withdrawal from the house treasury.
  Treasury;
};
type OpStatus = variant {
  Failed : record { reason : text };
  Unknown : record { attempts : nat32; reason : text };
  Completed : record { block : nat64 };
  Pending;
};
type PauseFlags = record {
  // No new seats, rooms or tournament entries.
  joins : bool;
  withdrawals : bool;
  deposits : bool;
  // No new hands are dealt (hands in progress finish).
  dealing : bool;
  reason : opt text;
};
type Phase = variant { Flop; Turn; River; HandOver; Waiting; PreFlop };
// A private note one player keeps about another. Only its author can see it.
type PlayerNote = record {
  updated_at : nat64;
  color : opt NoteColor;
  "text" : text;
};
type PlayerResult = record {
  won : nat64;
  player : principal;
  committed : nat64;
};
type Profile = record {
  id : principal;
  xp : nat64;
  ban : opt Ban;
  status : text;
  friend_requests : vec principal;
  chat_muted_until : nat64;
  username : text;
  balance : nat64;
  blocked : vec principal;
  chips : nat64;
  inventory : vec nat32;
  // When the next daily chip bonus can be claimed (ns).
  next_daily_at : nat64;
  created_at : nat64;
  level : nat32;
  // Size of the next daily bonus.
  next_daily_amount : nat64;
  stats : Stats;
  settings : Settings;
  card_back : nat32;
  friends : vec principal;
  daily_streak : nat32;
  avatar : nat32;
  medals : vec EarnedMedal;
};
type PublicProfile = record {
  id : principal;
  status : text;
  username : text;
  level : nat32;
  tables : vec nat64;
  stats : Stats;
  avatar : text;
  medals : vec text;
  online : bool;
};
// What the referrals page shows. The zero view (`Default`) is for an
// anonymous caller or a player with no profile.
type ReferralView = record {
  // Friends who earned something in the last 7 days. Counted over the
  // newest `ACTIVE_SCAN_MAX` (2,000) friends only, so with more friends than
  // that it can undercount.
  active_7d : nat32;
  // Username of the caller's referrer.
  my_referrer : opt text;
  // Within the first 24 hours and no referrer yet.
  can_enter_code : bool;
  // The caller's username, which is their referral code.
  code : text;
  // At most `FRIENDS_PAGE` friends, newest first, from `offset`.
  rows : vec FriendRow;
  // Cuts waiting for the next Monday payout (e8s).
  owed_this_week : nat64;
  paid_total : nat64;
  friends : nat32;
  // The next Monday 00:00 UTC (ns), when `owed_this_week` is paid.
  pays_at : nat64;
};
type Report = record {
  id : nat64;
  status : ReportStatus;
  created_at : nat64;
  target : principal;
  // The target's recent messages in that channel, captured when reported.
  evidence : vec ChatMessage;
  reporter_name : text;
  details : text;
  channel : opt Channel;
  reporter : principal;
  target_name : text;
  reason : ReportReason;
};
// A page of the open-report queue, oldest first.
type ReportPage = record {
  // All open reports, not just this page.
  open_total : nat64;
  reports : vec Report;
};
type ReportReason = variant {
  Spam;
  Cheating;
  Collusion;
  Other;
  OffensiveName;
  AbusiveChat;
};
type ReportStatus = variant {
  Open;
  Resolved : record {
    at : nat64;
    by : principal;
    action : ModAction;
    note : text;
  };
};
type Result = variant { Ok; Err : text };
type Result_1 = variant { Ok : nat32; Err : text };
type Result_10 = variant { Ok : vec LedgerOp; Err : text };
type Result_11 = variant { Ok : AutoSitStatus; Err : text };
type Result_12 = variant { Ok : ModPlayerView; Err : text };
type Result_13 = variant { Ok : ReportPage; Err : text };
type Result_14 = variant { Ok : vec Report; Err : text };
type Result_15 = variant { Ok : Profile; Err : text };
type Result_16 = variant { Ok : SpinRecord; Err : text };
type Result_2 = variant { Ok : vec AuditEntry; Err : text };
type Result_3 = variant { Ok : record { nat64; nat64 }; Err : text };
type Result_4 = variant { Ok : SolvencyReport; Err : text };
type Result_5 = variant { Ok : nat64; Err : text };
type Result_6 = variant { Ok : AdminConfig; Err : text };
type Result_7 = variant { Ok : Metrics; Err : text };
type Result_8 = variant { Ok : HouseStats; Err : text };
type Result_9 = variant { Ok : LedgerOp; Err : text };
// What the rewards screen shows for a player.
type RewardsView = record {
  tier_name : text;
  meter : nat64;
  tiers : vec TierInfo;
  step : nat64;
  tier : nat8;
  next_tier_at : opt nat64;
  // After decay.
  tier_points : nat64;
  history : vec SpinRecord;
  lifetime_points : nat64;
  days_since_earned : nat64;
  // Days of grace left before decay starts (0 = decaying now); none without points.
  decay_starts_in_days : opt nat64;
  fish_pool : nat64;
  spins_banked : nat32;
};
// What the signed-in caller may administer (drives the admin page).
type Roles = record { admin : bool; moderator : bool };
type RoomArgs = record {
  action_timeout_secs : nat64;
  password : opt text;
  name : text;
  max_seats : nat8;
  currency : Currency;
  big_blind : nat64;
};
type SeatView = record {
  bet : nat64;
  in_hand : bool;
  // Seconds left in this player's time bank.
  time_bank_secs : nat32;
  username : text;
  player : principal;
  // Who sent the current gift (their username).
  gift_from : opt text;
  all_in : bool;
  cards : blob;
  gift : opt text;
  // The viewer's own note about this player, if any.
  note : opt PlayerNote;
  has_cards : bool;
  seat : nat8;
  last_action : opt text;
  // When the current gift was sent; a repeat of the same gift gets a new time.
  gift_sent_at : opt nat64;
  level : nat32;
  stack : nat64;
  card_back : text;
  sitting_out : bool;
  folded : bool;
  avatar : text;
};
// Public status: what's paused and the latest solvency check.
type ServiceStatus = record {
  solvency : opt SolvencyReport;
  pause : PauseFlags;
};
type Settings = record {
  // Refill your stack to the table maximum after each hand when it drops below half.
  auto_top_up : bool;
  // Don't show losing hands at showdown.
  auto_muck : bool;
  four_color_deck : bool;
  sound : bool;
  show_throwables : bool;
};
type ShownHand = record {
  player : principal;
  cards : blob;
  hand : text;
  seat : nat8;
};
type SignupChallenge = record {
  // Required leading zero bits of sha256("bp-signup" ‖ principal ‖ nonce as u64 LE).
  difficulty : nat8;
};
type SolvencyReport = record {
  ok : bool;
  liabilities : nat64;
  ledger_balance : nat64;
  // Ledger balance minus liabilities (negative means insolvent).
  surplus : int;
  unresolved_ops : nat64;
  checked_at : nat64;
};
// One spin of the wheel, as shown in the player's history.
type SpinRecord = record {
  paid : nat64;
  tier : text;
  time : nat64;
  multiplier_x10 : nat64;
  stake : nat64;
  // Index into the wheel's segments (for the animation).
  segment : nat8;
  capped : bool;
  // Before the pool cap.
  prize : nat64;
};
type Standing = record {
  table : opt nat64;
  username : text;
  player : principal;
  chips : nat64;
  place : opt nat32;
  prize : nat64;
  avatar : text;
};
type Stats = record {
  // Largest ICP pot won, in e8s.
  biggest_pot_won : nat64;
  hands_won : nat64;
  // Net play chips won or lost at chip tables.
  chip_net : int64;
  // Net ICP won or lost at ICP tables, in e8s.
  net_winnings : int64;
  hands_played : nat64;
};
type StoreItem = record {
  id : nat32;
  // Emoji or image URL rendered by the frontend.
  icon : text;
  kind : ItemKind;
  name : text;
  description : text;
  available : bool;
  // Price in play chips. Zero means it can't be bought with chips.
  chip_price : nat64;
  // Price in e8s. Zero means free.
  price : nat64;
};
type TableConfig = record {
  small_blind : nat64;
  action_timeout_secs : nat64;
  min_buy_in : nat64;
  name : text;
  // Bad-beat jackpot drop in basis points of the pot after rake (flop only). 0 = no jackpot.
  jackpot_bps : nat16;
  jackpot_cap : nat64;
  // Rake in basis points of the pot (250 = 2.5%). Only taken when a flop is dealt.
  rake_bps : nat16;
  rake_cap : nat64;
  max_seats : nat8;
  currency : Currency;
  big_blind : nat64;
  max_buy_in : nat64;
};
type TableSummary = record {
  id : nat64;
  small_blind : nat64;
  min_buy_in : nat64;
  // The game this table belongs to: the original table's id (its own id for originals and rooms).
  game : nat64;
  name : text;
  // No more copies of this game can open right now (always true for rooms).
  game_at_cap : bool;
  locked : bool;
  max_seats : nat8;
  avg_pot : nat64;
  players : nat8;
  currency : Currency;
  // 1 for the original, 2.. for copies opened when the game filled up.
  number : nat8;
  big_blind : nat64;
  phase : Phase;
  // Username of the player who created this room, for player-created tables.
  room_owner : opt text;
  max_buy_in : nat64;
};
type TableView = record {
  id : nat64;
  now : nat64;
  pot : nat64;
  my_seat : opt nat8;
  to_call : nat64;
  // The viewer's place in this table's auto-sit line, if they're in it.
  my_auto_sit : opt AutoSitView;
  // The game this table belongs to: the original table's id (its own id for originals and rooms).
  game : nat64;
  hand_no : nat64;
  // Bad-beat jackpot for this table's currency (0 at tournament tables).
  jackpot : nat64;
  // A jackpot hit in the hand on screen, for the celebration.
  jackpot_hit : opt JackpotHit;
  // Joining needs a password.
  locked : bool;
  last_result : opt HandResult;
  tournament : opt TournamentBadge;
  // The player to act is on their time bank (`action_deadline` includes it).
  time_bank_active : bool;
  min_raise_to : nat64;
  seats : vec opt SeatView;
  action_deadline : nat64;
  to_act : opt nat8;
  current_bet : nat64;
  // Items thrown in the last few seconds, for clients to animate.
  throws : vec ThrowEvent;
  // 1 for the original, 2.. for copies opened when the game filled up.
  number : nat8;
  // A private room the viewer hasn't unlocked: game details are hidden.
  restricted : bool;
  board : blob;
  phase : Phase;
  config : TableConfig;
  // The player who created this room, if it is a player-created table.
  room_owner : opt principal;
  button : nat8;
  // How many watchers are waiting to be seated here automatically.
  auto_sit_waiting : nat32;
  // Smallest buy-in the viewer may sit down with (they left recently with
  // this many chips); 0 means the table's normal minimum.
  my_min_buy_in : nat64;
  max_raise_to : nat64;
};
type ThrowEvent = record {
  id : nat64;
  from_seat : nat8;
  to_seat : nat8;
  icon : text;
  time : nat64;
};
type TierInfo = record { rate_bps : nat64; from : nat64; name : text };
type TournamentBadge = record {
  id : nat64;
  // The viewer may rebuy right now.
  can_rebuy : bool;
  small_blind : nat64;
  rebuy_cost : nat64;
  // The viewer may take the add-on right now.
  can_addon : bool;
  addon_chips : nat64;
  name : text;
  level : nat32;
  addon_cost : nat64;
  finished : bool;
  currency : Currency;
  big_blind : nat64;
  entrants : nat32;
  players_left : nat32;
  rebuys_left : nat32;
  my_place : opt nat32;
  my_prize : nat64;
  // Busted viewer's deadline to rebuy (0 if not waiting).
  rebuy_deadline : nat64;
  next_level_at : nat64;
};
type TournamentDetail = record {
  small_blind : nat64;
  standings : vec Standing;
  level : nat32;
  tables : vec nat64;
  summary : TournamentSummary;
  big_blind : nat64;
  next_level_at : nat64;
  payouts : vec nat64;
};
type TournamentKind = variant {
  // Starts at a set time if enough players registered.
  Scheduled;
  // Starts as soon as it fills up.
  SitAndGo;
};
type TournamentStatus = variant { Finished; Running; Cancelled; Registering };
type TournamentSummary = record {
  id : nat64;
  fee : nat64;
  status : TournamentStatus;
  max_rebuys : nat32;
  // The table the viewer is playing at, if any.
  my_table : opt nat64;
  min_players : nat32;
  rebuy_levels : nat32;
  start_at : nat64;
  addon_chips : nat64;
  kind : TournamentKind;
  name : text;
  level_secs : nat64;
  max_players : nat32;
  level : nat32;
  // Total buy-ins: registrations plus rebuys.
  entries : nat32;
  addon_cost : nat64;
  currency : Currency;
  prize_pool : nat64;
  players_left : nat32;
  registered_me : bool;
  starting_stack : nat64;
  buy_in : nat64;
  late_reg_levels : nat32;
  registered : nat32;
  // Registration is open right now (before the start, or during late registration).
  can_register : bool;
};
type TournamentTemplate = record {
  // Goes to the house (ICP) or leaves circulation (chips).
  fee : nat64;
  max_rebuys : nat32;
  min_players : nat32;
  // Rebuys are allowed while the level (0-based) is below this. 0 = freezeout.
  rebuy_levels : nat32;
  addon_chips : nat64;
  kind : TournamentKind;
  name : text;
  level_secs : nat64;
  // Scheduled events: time between runs.
  interval_secs : nat64;
  max_players : nat32;
  // Minimum prize pool, only for play-chip events (the house mints chips).
  guarantee : nat64;
  // One-time add-on at the end of the rebuy period: price (into the pool, no fee)
  // and the chips it buys. 0 = no add-on.
  addon_cost : nat64;
  currency : Currency;
  starting_stack : nat64;
  // Goes into the prize pool.
  buy_in : nat64;
  table_size : nat8;
  // Registration stays open while the level (0-based) is below this. 0 = no late registration.
  late_reg_levels : nat32;
};
type Winner = record {
  player : principal;
  hand : text;
  seat : nat8;
  amount : nat64;
};
service : (opt InitArgs) -> {
  act : (nat64, Action) -> (Result);
  // Takes the one-time add-on at the end of a tournament's rebuy period.
  addon_tournament : (nat64) -> (Result);
  admin_add_item : (StoreItem) -> (Result_1);
  // Adds a recurring tournament (a sit-and-go or a scheduled event).
  admin_add_tournament : (TournamentTemplate) -> (Result_1);
  // Privileged actions (admins and moderators), newest first.
  admin_audit_log : (nat32) -> (Result_2) query;
  // Recomputes the sum of ICP balances by scanning every user, to verify the running total.
  admin_audit_wallet_total : () -> (Result_3) query;
  // Compares the canister's ICP balance with everything it owes. A shortfall
  // pauses withdrawals automatically. Also runs every 10 minutes on its own.
  admin_check_solvency : () -> (Result_4);
  admin_create_table : (TableConfig) -> (Result_5);
  admin_get_config : () -> (Result_6) query;
  admin_get_metrics : () -> (Result_7) query;
  admin_house_stats : () -> (Result_8) query;
  // Settles an unknown op after checking the ledger by hand (beyond the 24h retry window).
  admin_resolve_op : (nat64, bool, opt nat64) -> (Result_9);
  // Re-sends an unknown op right away (it's deduplicated by the ledger).
  admin_retry_op : (nat64) -> (Result_9);
  // Moves ICP from the house treasury into the bad-beat jackpot.
  admin_seed_jackpot : (nat64) -> (Result);
  // Replaces the chat/username word filter (whole words, case-insensitive).
  admin_set_banned_words : (vec text) -> (Result);
  admin_set_item_available : (nat32, bool) -> (Result);
  admin_set_moderator : (principal, bool) -> (Result);
  // Emergency switches: pause deposits, withdrawals, dealing and/or new joins.
  admin_set_pause : (PauseFlags) -> (Result);
  // Hourly sign-up target: past it, sign-ups need more proof-of-work (0 closes sign-ups).
  admin_set_signup_limit : (nat32) -> (Result);
  // Base sign-up proof-of-work, in leading zero bits (default 12, max 22).
  admin_set_signup_pow : (nat8) -> (Result);
  // Ledger operations whose outcome is unknown and need attention.
  admin_unresolved_ops : () -> (Result_10) query;
  // Withdraws house revenue (rake and store sales) from the treasury.
  admin_withdraw_treasury : (Account, nat64) -> (Result_5);
  // Waits for a seat at a table: you're seated automatically, with this buy-in,
  // when one opens. `None` leaves the line. Keep calling `auto_sit_ping` while
  // you watch, or you're dropped from the line.
  auto_sit : (nat64, opt nat64) -> (Result_11);
  // Keeps you in a table's auto-sit line and reports whether you were seated or dropped.
  auto_sit_ping : (nat64) -> (Result_11);
  // Blocks (or unblocks) a player: hides their chat and stops DMs, friend
  // requests, gifts and throws between you.
  block_player : (principal, bool) -> (Result);
  buy_item : (nat32, Currency) -> (Result);
  // Claims the daily free play-chip bonus (bigger on consecutive days).
  claim_daily_chips : () -> (Result_5);
  // Deposit via plain transfer: send ICP to your deposit account (see
  // `get_deposit_info`) from any wallet or exchange, then call this. Returns the amount credited.
  claim_deposit : () -> (Result_5);
  close_room : (nat64) -> (Result);
  // Creates your own table. Hosts of ICP tables earn 20% of the rake it generates.
  create_room : (RoomArgs) -> (Result_5);
  // Deposit via ICRC-2: the caller first approves this canister for
  // `amount + fee` on the ICP ledger, then calls this. Returns the new balance.
  deposit : (nat64) -> (Result_5);
  equip : (nat32) -> (Result);
  find_user : (text) -> (opt PublicProfile) query;
  get_chat : (Channel, nat64) -> (vec ChatMessage) query;
  get_deposit_info : () -> (DepositInfo) query;
  get_dms : (principal, nat64) -> (vec ChatMessage) query;
  get_friends : () -> (vec FriendInfo) query;
  // Full replay of a hand you played in.
  get_hand : (nat64) -> (opt HandRecord) query;
  // Your most recent hands, newest first.
  get_hand_history : (nat32) -> (vec HandSummary) query;
  // Current bad-beat jackpots, the rules and recent hits.
  get_jackpots : () -> (JackpotInfo) query;
  get_leaderboard : () -> (vec LeaderboardEntry) query;
  // The four weekly and monthly leaderboards, with the caller's own row.
  get_leaderboards : () -> (vec BoardView) query;
  // Your recent deposits and withdrawals, newest first.
  get_my_ledger_ops : () -> (vec LedgerOp) query;
  get_my_profile : () -> (opt Profile) query;
  get_my_roles : () -> (Roles) query;
  // All your notes, most recently updated first.
  get_notes : () -> (vec NoteView) query;
  get_profile : (principal) -> (opt PublicProfile) query;
  // The caller's referral earnings and friends, `offset` friends in (newest first).
  get_referrals : (nat32) -> (ReferralView) query;
  // The caller's Fish Buffet standing, spins and history.
  get_rewards : () -> (RewardsView) query;
  // How much sign-up work a new account needs right now (see `register`).
  get_signup_challenge : () -> (SignupChallenge) query;
  get_status : () -> (ServiceStatus) query;
  get_table : (nat64) -> (opt TableView) query;
  // `password` is only needed for password-protected player rooms.
  // Views of several tables at once (for multi-tabling); unknown ids are skipped.
  get_tables : (vec nat64) -> (vec TableView) query;
  get_tournament : (nat64) -> (opt TournamentDetail) query;
  // `GET /metrics` (Prometheus text, without the house's money figures) and
  // `GET /health` on the canister's raw domain. Responses are not certified, so
  // they're for monitoring only.
  http_request : (HttpRequest) -> (HttpResponse) query;
  // Joins a game: a free seat at its fullest table, or a new copy of it when every
  // table is full. Returns the id of the table you were seated at.
  join_game : (nat64, nat64) -> (Result_5);
  // `password` is only needed for password-protected player rooms.
  join_table : (nat64, nat8, nat64, opt text) -> (Result);
  leave_table : (nat64) -> (Result_5);
  list_medals : () -> (vec MedalDef) query;
  list_store : () -> (vec StoreItem) query;
  list_tables : () -> (vec TableSummary) query;
  list_tournaments : () -> (vec TournamentSummary) query;
  // Suspends a player for `hours` (0 = permanent). They keep access to withdrawals.
  mod_ban : (principal, nat32, text) -> (Result);
  mod_get_player : (principal) -> (Result_12) query;
  // Mutes a player in every chat for `hours` (0 lifts the mute).
  mod_mute : (principal, nat32) -> (Result);
  // The open-report queue, oldest first: up to `limit` (max 50) after report `after`.
  mod_open_reports : (opt nat64, nat32) -> (Result_13) query;
  // The latest reports, open or resolved.
  mod_recent_reports : (nat32) -> (Result_14) query;
  mod_resolve_report : (nat64, ModAction, text) -> (Result);
  mod_unban : (principal) -> (Result);
  // Buys a fresh starting stack during a tournament's rebuy period (buy-in only, no fee).
  rebuy_tournament : (nat64) -> (Result);
  // Creates your profile. `pow` is a nonce solving `get_signup_challenge`.
  register : (text, opt nat64) -> (Result_15);
  register_tournament : (nat64) -> (Result);
  remove_friend : (principal) -> (Result);
  // Reports a player to the moderators. With a channel, their recent messages
  // there are attached as evidence. Returns the report id.
  report_player : (principal, ReportReason, text, opt Channel) -> (Result_5);
  respond_friend_request : (principal, bool) -> (Result);
  send_chat : (Channel, text) -> (Result);
  send_dm : (principal, text) -> (Result);
  send_friend_request : (principal) -> (Result);
  send_gift : (nat64, principal, nat32, Currency) -> (Result);
  // Saves a private note about a player. Empty text and no color deletes it.
  set_note : (principal, text, opt NoteColor) -> (Result);
  // Attaches a referrer (another player's username) within your first 24 hours.
  set_referrer : (text) -> (Result);
  set_status : (text) -> (Result);
  // Shows your cards after winning a hand uncontested, until the next hand is dealt.
  show_cards : (nat64) -> (Result);
  sit_out : (nat64, bool) -> (Result);
  // Spins the oldest banked Fish Buffet spin for ICP cashback.
  spin_wheel : () -> (Result_16);
  throw_item : (nat64, principal, nat32, Currency) -> (Result);
  top_up : (nat64, nat64) -> (Result);
  // Enters a private room's password so you can watch it and chat there.
  unlock_room : (nat64, text) -> (Result);
  unregister_tournament : (nat64) -> (Result);
  update_settings : (Settings) -> (Result);
  whoami : () -> (principal) query;
  // Sends `amount` e8s to `to`. The ledger fee is charged on top. Returns the block index.
  withdraw : (Account, nat64) -> (Result_5);
}