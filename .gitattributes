# Shell scripts run in Linux/WSL: keep LF endings even on Windows checkouts.
*.sh text eol=lf
*.did text eol=lf
src/poker_frontend/src/declarations/** text eol=lf
src/poker_frontend/src/fair/vectors.json text eol=lf
# Served as-is by the frontend canister: the HTTP gateways read ic-domains line by line.
src/poker_frontend/public/.well-known/** text eol=lf
src/poker_frontend/public/_headers text eol=lf
